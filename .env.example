# SparkMind Environment Configuration
# GEMINI_API_KEY: Required server-side for Gemini AI API calls.
# On Netlify: Set under Site Settings > Environment Variables > GEMINI_API_KEY
# Primary Gemini API Key
GEMINI_API_KEY="your_primary_gemini_api_key_here"

# Spare Gemini API Key (Optional backup: Automatically used if Key #1 hits rate/quota limits)
GEMINI_API_KEY_2="your_spare_gemini_api_key_here"

# Model selection (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: Optional base URL
APP_URL="http://localhost:3000"

# Mail SMTP Server Configuration (Optional - for sending OTP emails directly)
# If provided, OTP emails will be sent directly via this SMTP server.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="SparkMind AI <no-reply@sparkmind.ai>"

